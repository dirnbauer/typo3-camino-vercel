{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.cron",
    "watchPatterns": [
      "docker/run-remote-scheduler.sh",
      "Dockerfile.cron",
      "platforms/railway/cron.json"
    ]
  },
  "deploy": {
    "cronSchedule": "*/15 * * * *",
    "restartPolicyType": "NEVER"
  }
}
